<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 课程名（大标题） -->
        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="课程名"
            android:textColor="#222222"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 本周是否上这门课：一眼看到 -->
        <TextView
            android:id="@+id/tvDetailOnWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="本周上"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- 详情字段 -->
        <TextView
            android:id="@+id/tvDetailTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="教师："
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDetailTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="时间："
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDetailSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="节次："
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDetailLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="教室："
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDetailWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="周次："
            android:textColor="#333333"
            android:textSize="15sp" />

        <!-- 操作按钮 -->
        <Button
            android:id="@+id/btnDetailDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="删除这门课" />

        <Button
            android:id="@+id/btnDetailBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="返回列表" />

    </LinearLayout>

</ScrollView>
