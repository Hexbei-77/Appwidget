        <TextView android:id="@+id/wvR1D6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="2dp" android:gravity="center" android:ems="1" android:maxLines="12" android:padding="1dp" android:textColor="#333333" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/wvR1D7" android:layout_width="0dp" android:layout_height="match_parent" android:gravity="center" android:ems="1" android:maxLines="12" android:padding="1dp" android:textColor="#333333" android:textSize="9sp" android:textStyle="bold" />
